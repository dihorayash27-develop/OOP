#include<iostream.h>
#include<conio.h>
#include<iomanip.h>
#include<math.h>


class Point
{
	private:

		double x1, x2, y1, y2;

	public:

		Point()
		{
			//cout<<"Point Class Default Constructor is Called..."<<endl;
			x1=0;
			y1=0;
			x2=0;
			y2=0;
		}
		Point(double a1, double b1, double a2, double b2)
		{
			//cout<<"Point Class Parameterised Constructor is Called to Assign Values..."<<endl;
			x1=a1;
			y1=b1;
			x2=a2;
			y2=b2;
		}
		operator double();
		void out()
		{
			cout<<"\n\nValues of X1 : "<<x1<<endl;
			cout<<"Values of Y1 : "<<y1<<endl;
			cout<<"\nValues of X2 : "<<x2<<endl;
			cout<<"Values of Y2 : "<<y2<<endl;
		}

		~Point()
		{
			//cout<<"\nPoint Class Destructor is Called...."<<endl;
		}
};



Point :: operator double()
{
	cout<<"\n\n\t*****-----Point Class Type to => Basic Double Type-----*****\n"<<endl;
	double d=sqrt(pow((x2-x1), 2) + pow((y2-y1), 2));

	return d;
}

void main()
{
	clrscr();

	Point P1(5, 6, -7, 11);
	//double dis=P1;
	double dis=P1.operator double();

	cout<<"\n\nDistance, After Cast Conversion : "<<dis<<"\n"<<endl;
	P1.out();

	getch();
}